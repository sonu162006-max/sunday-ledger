# =============================================================================
# Sunday Ledger — Environment Variables Configuration
# =============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# For production (e.g., Vercel + Neon PostgreSQL), configure these variables
# in your Vercel Project Settings -> Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon Serverless)
# -----------------------------------------------------------------------------

# DATABASE_URL:
# Connection string used by Prisma Client for all application runtime queries.
#
# Production (Neon with PgBouncer Connection Pooling):
# Use the POOLED connection string from your Neon dashboard (-pooler host).
# Append '?sslmode=require&pgbouncer=true&connect_timeout=15' to ensure optimal
# connection reuse across Vercel serverless functions.
# Example:
#   DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
#
# Local Development:
# Use your local PostgreSQL instance:
DATABASE_URL="postgresql://postgres:password@localhost:5432/sunday_ledger?schema=public"

# DIRECT_URL:
# Direct (unpooled) connection string used exclusively by Prisma CLI for migrations
# (e.g., 'prisma migrate deploy') and schema push commands that require PostgreSQL advisory locks.
#
# Production (Neon Direct Connection):
# Use the non-pooled connection string from your Neon dashboard (omit '-pooler' from hostname).
# Example:
#   DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Local Development:
# Identical to DATABASE_URL when running a standard local Postgres instance:
DIRECT_URL="postgresql://postgres:password@localhost:5432/sunday_ledger?schema=public"

# -----------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION CONFIGURATION
# -----------------------------------------------------------------------------

# NEXTAUTH_SECRET:
# A cryptographically secure random string used to encrypt NextAuth JWT tokens
# and sign session cookies. NEVER commit the actual value to Git.
#
# Generate a new random secret using your terminal:
#   openssl rand -base64 32
# or using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="your-32-byte-base64-random-secret-here"

# NEXTAUTH_URL:
# The canonical public URL where your application is hosted.
# NextAuth uses this to construct redirect callback URLs.
#
# Local Development:
NEXTAUTH_URL="http://localhost:3000"
#
# Production:
# Set this to your custom domain or Vercel production domain:
# NEXTAUTH_URL="https://sunday-ledger.vercel.app"

# -----------------------------------------------------------------------------
# 3. INITIAL ADMIN USER SEEDING CREDENTIALS
# -----------------------------------------------------------------------------

# When running 'npm run seed' (or 'npx prisma db seed'), the seed script creates
# or updates the initial administrator account with the credentials below.
# Both variables are REQUIRED by prisma/seed.ts. The script intentionally aborts
# if either variable is missing to prevent insecure default credentials.

SEED_ADMIN_EMAIL="admin@sundayledger.com"
SEED_ADMIN_PASSWORD="YourStrongSecurePasswordHere123!"
